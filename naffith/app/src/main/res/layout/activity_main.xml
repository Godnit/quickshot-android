<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="نفّذ"
        android:textColor="@color/primary"
        android:textSize="30sp"
        android:textStyle="bold"
        android:gravity="right" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="اكتب أمرًا لفتح تطبيق أو البحث داخله"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:gravity="right" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:padding="12dp">

            <EditText
                android:id="@+id/commandInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="مثال: افتح يوتيوب"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:minHeight="56dp"
                android:textDirection="rtl"
                android:gravity="right|top" />

            <Button
                android:id="@+id/executeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="تنفيذ الأمر"
                android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="السجل"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="right" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:fillViewport="true">

        <TextView
            android:id="@+id/logView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:text="مرحبًا. اكتب أمرًا للبدء.\n\nأمثلة:\n• افتح تطبيق لقطة شاشة\n• ما هي التطبيقات المثبتة\n• ابحث في يوتيوب عن موسيقى\n• افتح مشغل ام اكس وابحث عن موسيقى\n• ابحث في كروم عن أخبار اليوم"
            android:textColor="@color/text_primary"
            android:textDirection="rtl"
            android:textSize="15sp"
            android:gravity="right" />
    </ScrollView>

    <TextView
        android:id="@+id/accessibilityHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="للبحث داخل التطبيقات: فعّل نفّذ من إعدادات إمكانية الوصول."
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:gravity="right" />
</LinearLayout>
