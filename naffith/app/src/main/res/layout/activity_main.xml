<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="نفّذ"
        android:textColor="@color/primary"
        android:textSize="30sp"
        android:textStyle="bold"
        android:gravity="right" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="اكتب ما تريد، وسأنفذ الأوامر المتاحة محليًا"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:gravity="right" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <EditText
                android:id="@+id/commandInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="مثال: افتح يوتيوب"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:minHeight="56dp"
                android:textDirection="rtl"
                android:gravity="right|top" />

            <Button
                android:id="@+id/executeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="تنفيذ الأمر"
                android:textSize="16sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="السجل"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="right" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:fillViewport="true">

        <TextView
            android:id="@+id/logView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:text="مرحبًا. اكتب أمرًا للبدء.\n\nأمثلة:\n• افتح يوتيوب\n• ابحث في يوتيوب عن تعلم البرمجة\n• افتح الملفات\n• افتح الإعدادات"
            android:textColor="@color/text_primary"
            android:textDirection="rtl"
            android:textSize="15sp"
            android:gravity="right" />
    </ScrollView>

    <TextView
        android:id="@+id/accessibilityHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="التحكم في الشاشة سيحتاج تفعيل خدمة إمكانية الوصول من إعدادات أندرويد."
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:gravity="right" />
</LinearLayout>
